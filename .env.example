# Copy to .env and fill in. Used by the tracker (directly or via docker compose).
CAMERA_USERNAME=admin
# Wrap in double quotes if the password contains quotes, # or spaces.
CAMERA_PASSWORD="change-me"
CAMERA_PORT=80
# Referenced by `ip_env` in tracker/config.yaml. Cameras can instead use a literal `ip`.
LEFT_TO_RIGHT_IP=192.168.4.61
RIGHT_TO_LEFT_IP=192.168.4.52

# Firmware build only (PlatformIO reads these from your shell environment, not this file):
# ENV_WIFI_SSID=...
# ENV_WIFI_PW=...
